# Storage: "file" (local/desktop, default off Vercel) or "blob" (Vercel Blob).
# Auto-selects blob on Vercel or when BLOB_READ_WRITE_TOKEN is present.
NEMO_STORAGE=file
NEMO_WORKSPACE_ROOT=../../.nemo-workspace

# Provisioned automatically when a Vercel Blob store is linked to the project.
# BLOB_READ_WRITE_TOKEN=

# Default is demo unless Vercel AI Gateway auth is present.
# Set NEMO_AI_MODE=live to require live model output, or demo to force fixtures.
NEMO_AI_MODE=demo
NEMO_AI_MODEL=anthropic/claude-sonnet-4.6

# Preferred local auth:
#   vercel link
#   vercel env pull apps/workspace/.env.local
# Alternative for non-Vercel environments:
# AI_GATEWAY_API_KEY=
