# --- Supabase (workflows, audit log, job queue, plans) ---
# Memory/documents still use Blob or local file storage.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# postgres = workflows in Supabase (auto when service role present)
# kv       = workflows in Blob/file store (legacy)
# NEMO_WORKFLOW_STORE=postgres

# Job processor auth (required for /api/jobs/process)
# CRON_SECRET=generate_a_long_random_string

# App URL for local job processor triggers (dev)
# NEMO_APP_URL=http://localhost:8420

# --- Deployment tier (pick one per Vercel project) ---
# demo        — public live demo: real URL fetch + grounded excerpts, no AI key
# paywall     — Pro: live AI via Gateway; honest block when credits unavailable
# production  — strict live AI only, no silent fallbacks
NEMO_TIER=demo

# Optional URLs shown on /pricing
# NEMO_PRO_URL=https://nemo-workspace-pro.vercel.app
# NEMO_PRODUCTION_URL=https://your-production-domain.com
# NEMO_PAYWALL_URL=https://vercel.com/docs/ai-gateway/pricing

# Storage: "file" (local/desktop) or "blob" (Vercel Blob).
NEMO_STORAGE=file
NEMO_WORKSPACE_ROOT=../../.nemo-workspace

# Provisioned automatically when a Vercel Blob store is linked to the project.
# BLOB_READ_WRITE_TOKEN=

# Legacy override (prefer NEMO_TIER). NEMO_AI_MODE=live maps to paywall tier.
# NEMO_AI_MODE=demo
NEMO_AI_MODEL=anthropic/claude-sonnet-4.6

# Production tier sets strict mode automatically. Force with:
# NEMO_AI_STRICT=1

# Preferred local auth:
#   vercel link
#   vercel env pull apps/workspace/.env.local
# Alternative for non-Vercel environments:
# AI_GATEWAY_API_KEY=
