# Supabase — same project for Auth + Postgres
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
# Server-only: webhook + optional admin operations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Hunter agent → POST /api/webhooks/hunter
# Send: Authorization: Bearer <this>
HUNTER_WEBHOOK_SECRET=generate_a_long_random_string

# --- Optional: “Run Hunter now” button on /queue (rep-only, server-side) ---
# Prefer A or B (not both required; webhook URL wins if both set).

# A) Your automation URL (Make, n8n, Cloudflare Worker…) that triggers GitHub Action or OpenClaw.
# HUNTER_DISPATCH_WEBHOOK_URL=https://hooks.example.com/…
# HUNTER_DISPATCH_WEBHOOK_SECRET=optional_bearer_shared_with_automation

# B) GitHub PAT with workflow dispatch on this repo (classic: repo + workflow; fine-grained: Actions write).
# HUNTER_GITHUB_DISPATCH_TOKEN=ghp_…
# HUNTER_GITHUB_REPO_OWNER=sentientsprite
# HUNTER_GITHUB_REPO=NEMO-APP-v.1
# HUNTER_GITHUB_WORKFLOW_FILE=outbound-crm-fixture-webhook.yml
# HUNTER_GITHUB_WORKFLOW_REF=main
